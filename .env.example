# ─── Core ────────────────────────────────────────────────────────────────
APP_URL=http://localhost:3000
# 32+ random characters. Signs anonymous-visitor cookies, demo sessions and local media URLs.
APP_SECRET=change-me-to-a-long-random-string
DATABASE_URL=postgres://openwithin:openwithin@localhost:5432/openwithin
# Supabase transaction pooler (port 6543) is supported; prepared statements are disabled automatically.

# Local development only. Enables, when the real provider is NOT configured:
#  - passwordless demo sign-in (instead of Supabase Auth)
#  - an offline placeholder voice via FFmpeg/flite (instead of ElevenLabs) — audio is labelled "demo"
#  - a simulated checkout (instead of Stripe test mode)
# Never enable in production with real users.
DEMO_MODE=true

# ─── Supabase (Auth + Storage) ───────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=audio
# Set to true once the Apple provider is configured in Supabase.
AUTH_APPLE_ENABLED=false
# local | supabase
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=./storage

# ─── Voice (ElevenLabs) ──────────────────────────────────────────────────
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL_FULL=eleven_multilingual_v2
ELEVENLABS_MODEL_PREVIEW=eleven_flash_v2_5

# ─── Script writing (LLM) ────────────────────────────────────────────────
# anthropic | none  (none = OpenWithin's built-in technique composer only)
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5

# ─── Payments (Stripe, use test keys) ────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Real transfers to professionals stay OFF until seller-of-record, tax and refund setup is complete.
MARKETPLACE_PAYOUTS_ENABLED=false

# ─── Jobs, limits & cost control ─────────────────────────────────────────
# Process jobs inside the web process right after the request (dev / single node). Set false when running `npm run worker`.
INLINE_WORKER=true
# Bearer token for GET /api/cron/jobs (serverless schedulers)
CRON_SECRET=
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
PREVIEW_MAX_PER_ANON=3
PREVIEW_MAX_PER_IP_HOUR=6
PREVIEW_GLOBAL_DAILY=2000
TTS_DAILY_CHAR_BUDGET=2000000

# Optional: video for the homepage hero (VSL). Without it an animated story is shown.
NEXT_PUBLIC_HERO_VIDEO_URL=
